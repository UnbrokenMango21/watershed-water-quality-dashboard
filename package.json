{
  "name": "pa-watershed-watch-backend",
  "private": true,
  "type": "module",
  "main": "functions/index.mjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:contracts": "node --test tests/validation/*.test.mjs tests/brand/*.test.mjs tests/qc/*.test.mjs tests/profile/*.test.mjs",
    "test:trigger": "node --test tests/validation-trigger/firestore_trigger.test.mjs",
    "test:review": "node tests/review/run-tests.cjs",
    "test:publication": "node --test tests/publication/*.test.mjs",
    "test:profile": "node --test tests/profile/*.test.mjs",
    "auth:ensure-dev-admin": "node scripts/ensure_dev_admin.mjs",
    "auth:cleanup-dev-users": "node scripts/cleanup_dev_auth_users.mjs",
    "test:emulator-identities": "node scripts/provision_test_users.mjs --apply && node scripts/seed_qc_smoke_data.mjs --apply"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "firebase-tools": "15.31.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "qs": "6.16.0"
  }
}
