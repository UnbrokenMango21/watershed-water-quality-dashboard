<?xml version="1.0" encoding="UTF-8"?>
<!-- Emulator-backed collector workflow UI tests. Kept out of the PAWatershedWatch scheme so default
     CI runs never need the Firebase Emulator Suite. Run via `bash scripts/dev.sh ios-ui`. -->
