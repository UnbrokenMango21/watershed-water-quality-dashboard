{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "image": "sdk-57"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "image": "sdk-57",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "sdk-57"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "sdk-57"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6800149959"
      }
    }
  }
}
