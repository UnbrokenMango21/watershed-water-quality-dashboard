{
  "version": "0.1.3",
  "database": "Cloud Firestore Standard",
  "environmentStrategy": {
    "developmentProject": "central-pa-watershed-dev",
    "developmentDatabase": "(default)",
    "developmentLocation": "nam5",
    "developmentLocationDescription": "United States (Central) multi-region",
    "productionProjectReserved": "central-pa-watershed-prod",
    "productionDataAllowedInDev": false
  },
  "analytics": {
    "enabled": true,
    "purpose": "privacy-safe product and UX telemetry only",
    "forbiddenPayloads": [
      "scientific measurement values",
      "exact GPS coordinates",
      "landowner/private property information",
      "field notes",
      "collector/reviewer email addresses",
      "reviewer comments",
      "authentication secrets or tokens"
    ]
  },
  "idPolicy": {
    "style": "UUID/non-sequential",
    "submissionId": "stable form/submission envelope ID",
    "eventId": "stable scientific SamplingEvent ID shared with ArcGIS",
    "revisionId": "immutable collector revision ID",
    "measurementId": "unique measurement record ID",
    "siteId": "stable site ID shared with ArcGIS"
  },
  "collections": {
    "users": {
      "documentId": "Firebase Auth uid",
      "fields": {
        "display_name": "string",
        "role": "COLLECTOR | QC_REVIEWER | ADMIN",
        "active": "boolean",
        "created_at": "Timestamp",
        "updated_at": "Timestamp"
      },
      "policy": "role is authoritative on the Firebase Auth custom claim (request.auth.token.role); this Firestore field is a readable mirror only. Only QC_REVIEWER and ADMIN may perform reviewer actions. There is no public reviewer signup; roles are provisioned server-side."
    },
    "siteCatalog": {
      "documentId": "site_id",
      "purpose": "mobile-safe site lookup only; never include landowner/private access fields",
      "fields": {
        "site_id": "string",
        "site_code": "string",
        "site_name_display": "string",
        "county": "string|null",
        "watershed_name": "string|null",
        "latitude": "number",
        "longitude": "number",
        "location": "GeoPoint",
        "site_tolerance_m": "number",
        "active": "boolean",
        "updated_at": "Timestamp"
      }
    },
    "submissions": {
      "documentId": "submission_id",
      "fields": {
        "submission_id": "string",
        "event_id": "string",
        "collector_user_id": "string",
        "site_id": "string",
        "status": "DRAFT | SUBMITTED | VALIDATING | PENDING_REVIEW | NEEDS_CORRECTION | RESUBMITTED | APPROVED | REJECTED | PUBLISHING | PUBLISH_FAILED | PUBLISHED",
        "current_revision_id": "string",
        "current_revision_no": "integer",
        "latest_collected_at": "Timestamp",
        "created_at": "Timestamp",
        "updated_at": "Timestamp (must equal request.time on DRAFT -> SUBMITTED and NEEDS_CORRECTION -> RESUBMITTED)",
        "submitted_at": "Timestamp|null (trusted server timestamp only on final collector transitions; client writes FieldValue.serverTimestamp() and rules require request.time)",
        "workflow_job_id": "string|null",
        "arcgis_staging_globalid": "string|null",
        "schema_version": "string",
        "mobile_app_version": "string",
        "validation_rules_version": "string|null",
        "quality_algorithm_version": "string|null",
        "overall_quality_score": "number|null",
        "anomaly_score": "number|null",
        "error_flag_count": "integer",
        "warning_flag_count": "integer",
        "info_flag_count": "integer",
        "review_decision": "APPROVE | NEEDS_CORRECTION | REJECT | null",
        "review_comment": "string|null",
        "reviewer_user_id": "string|null",
        "reviewed_at": "Timestamp|null",
        "reviewed_revision_id": "string|null",
        "published_at": "Timestamp|null"
      },
      "serverOwnedFields": [
        "workflow_job_id",
        "arcgis_staging_globalid",
        "validation_rules_version",
        "quality_algorithm_version",
        "overall_quality_score",
        "anomaly_score",
        "error_flag_count",
        "warning_flag_count",
        "info_flag_count",
        "review_decision",
        "review_comment",
        "reviewer_user_id",
        "reviewed_at",
        "reviewed_revision_id",
        "published_at"
      ],
      "subcollections": {
        "revisions": {
          "documentId": "revision_id",
          "policy": "collector science becomes immutable after revision is submitted",
          "fields": {
            "revision_id": "string",
            "revision_no": "integer",
            "submission_id": "string",
            "event_id": "string",
            "collector_user_id": "string",
            "site_id": "string",
            "revision_status": "DRAFT | SUBMITTED",
            "created_at": "Timestamp",
            "submitted_at": "Timestamp|null (trusted server timestamp only when the revision is finalized; client writes FieldValue.serverTimestamp() and rules require request.time)",
            "collected_at": "Timestamp",
            "time_known": "boolean",
            "time_imputed": "boolean",
            "latitude": "number",
            "longitude": "number",
            "location": "GeoPoint",
            "gps_accuracy_m": "number",
            "site_distance_m": "number|null",
            "weather_condition": "string",
            "data_collected_by": "string",
            "test_type": "string",
            "test_type_other": "string|null",
            "method_name": "string",
            "instrument_name": "string",
            "instrument_other": "string|null",
            "temp_entered_value": "number",
            "temp_entered_unit": "C | F",
            "temp_c": "number",
            "temp_f": "number",
            "field_notes_original": "string|null",
            "schema_version": "string",
            "mobile_app_version": "string",
            "validation": "server-owned map|null"
          },
          "serverOwnedFields": ["validation"],
          "subcollections": {
            "measurements": {
              "documentId": "measurement_id",
              "fields": {
                "measurement_id": "string",
                "parameter_code": "string",
                "display_name": "string",
                "value": "number",
                "unit_code": "string",
                "entered_value": "number",
                "entered_unit_code": "string",
                "method_name": "string",
                "instrument_name": "string",
                "qualifier": "string|null",
                "notes": "string|null",
                "entered_at": "Timestamp"
              },
              "policy": "value/unit_code are the canonical measurement used for validation, review, and publication. entered_value/entered_unit_code preserve exactly what the collector typed and selected. Firestore Rules allow only parameter-specific stable mobile unit IDs and valid canonical parameter/unit pairs; the trusted validation engine, not Rules, detects entered/canonical numerical conversion contradictions. Temperature uses the analogous temp_entered_value/temp_entered_unit/temp_c/temp_f fields on the revision instead of a measurement record."
            },
            "validationFlags": {
              "documentId": "flag_id",
              "serverWriteOnly": true,
              "fields": {
                "flag_id": "string",
                "severity": "ERROR | PLAUSIBILITY_WARNING | ENVIRONMENTAL_ALERT | INFO",
                "category": "string",
                "parameter_code": "string|null",
                "message": "string",
                "rule_code": "string",
                "created_at": "Timestamp",
                "resolved": "boolean"
              }
            },
            "attachments": {
              "documentId": "attachment_id",
              "fields": {
                "attachment_id": "string",
                "storage_path": "string",
                "content_type": "string",
                "kind": "SITE_PHOTO | INSTRUMENT_PHOTO | TEST_RESULT | OTHER",
                "caption": "string|null",
                "created_at": "Timestamp"
              }
            }
          }
        },
        "audit": {
          "documentId": "audit_id",
          "serverWriteOnly": true,
          "fields": {
            "audit_id": "string",
            "event_type": "string",
            "actor_type": "COLLECTOR | VALIDATION_SERVICE | QC_REVIEWER | PUBLISHING_SERVICE",
            "actor_id": "string|null",
            "occurred_at": "Timestamp",
            "previous_state": "string|null",
            "new_state": "string|null",
            "revision_id": "string|null",
            "reason": "string|null",
            "metadata": "map|null"
          }
        }
      }
    }
  },
  "temperatureBehavior": {
    "input": "collector selects C or F and enters one value",
    "conversion": {
      "C_from_F": "(F - 32) * 5 / 9",
      "F_from_C": "C * 9 / 5 + 32"
    },
    "displayPrecision": 2,
    "storeEnteredValueAndUnit": true,
    "storeBothDerivedValues": true
  },
  "workflowTransitions": {
    "clientAllowed": [
      "DRAFT -> SUBMITTED",
      "NEEDS_CORRECTION -> RESUBMITTED"
    ],
    "serverOnly": [
      "SUBMITTED -> VALIDATING",
      "RESUBMITTED -> VALIDATING",
      "VALIDATING -> PENDING_REVIEW",
      "VALIDATING -> NEEDS_CORRECTION",
      "PENDING_REVIEW -> NEEDS_CORRECTION",
      "PENDING_REVIEW -> APPROVED",
      "PENDING_REVIEW -> REJECTED",
      "APPROVED -> PUBLISHING",
      "PUBLISHING -> PUBLISHED",
      "PUBLISHING -> PUBLISH_FAILED"
    ]
  },
  "reviewWorkflow": {
    "actions": ["APPROVE", "NEEDS_CORRECTION", "REJECT"],
    "actorRoles": ["QC_REVIEWER", "ADMIN"],
    "reasonRequired": {"APPROVE": false, "NEEDS_CORRECTION": true, "REJECT": true},
    "executionPath": "Server-only (Firebase Admin SDK, Application Default Credentials). Never invoked from browser/client code.",
    "guarantees": [
      "atomic: submission patch, and audit event commit in one Firestore transaction",
      "transactional: read-check-write inside db.runTransaction",
      "revision-aware: the request must name the submission's current_revision_id; a mismatch is rejected",
      "race-safe: Firestore transaction read-then-write plus the revision/status check prevents two concurrent reviewers from double-applying a decision",
      "idempotent: a repeated identical request (same submissionId, revisionId, decision) after it already applied returns the same result without writing a second audit event",
      "stale: a request naming a revision or status that no longer matches current server state is rejected with HTTP 409",
      "immutable revision: the review path never writes to submissions/{id}/revisions/{id} or its measurements subcollection"
    ]
  },
  "privacy": {
    "landownerFieldsInFirestoreMobileCatalog": false,
    "collectorCanWriteQualityScores": false,
    "collectorCanWriteReviewFields": false,
    "collectorCanWritePublicationFields": false,
    "collectorCanWriteRevisionValidationMap": false
  }
}
