{
  "protocolVersion": "0.2.0",
  "dashboardTitle": "Central PA Watershed Dashboard",
  "requiredStructuralFields": [
    "siteId",
    "testType",
    "dataCollectedBy",
    "measurementMethod",
    "collectedDate",
    "collectedTime",
    "latitude",
    "longitude",
    "gpsAccuracyM",
    "weatherCondition",
    "waterColor",
    "flowCondition"
  ],
  "requiredCoreParameters": [],
  "optionalParameters": [
    "WATER_TEMP_C",
    "PH",
    "DO_MG_L",
    "CONDUCTIVITY_US_CM",
    "DO_PERCENT",
    "TDS_MG_L",
    "ORP_MV",
    "CHLORIDE_MG_L",
    "SULFATE_MG_L",
    "NITRATE_MG_L",
    "PHOSPHATE_MG_L",
    "DISCHARGE_M3_S",
    "WATER_DEPTH_M"
  ],
  "legacyDefaults": {
    "testType": "In-situ/Penn State Lab",
    "dataCollectedBy": "Student/researcher"
  },
  "testTypeChoices": [
    "In-situ / Field Instrument",
    "Penn State Lab",
    "External Lab",
    "Field Kit / Colorimetric",
    "Continuous Sensor / Sonde",
    "Mixed In-situ + Lab",
    "Other"
  ],
  "otherRequiresText": true,
  "temperatureEntry": {
    "userChoosesUnit": true,
    "allowedInputUnits": [
      "F",
      "C"
    ],
    "canonicalUnit": "C",
    "formulaFtoC": "(F - 32) * 5 / 9",
    "formulaCtoF": "C * 9 / 5 + 32",
    "displayMaxDecimals": 2,
    "preserveEnteredValue": true,
    "markDerivedCounterpart": true
  },
  "gps": {
    "required": true,
    "captureAutomatically": true,
    "manualEntryDefault": false,
    "storeAccuracyMeters": true,
    "preferredAccuracyM": 10,
    "acceptableAccuracyM": 20,
    "warningAccuracyM": 50
  },
  "reviewPolicy": {
    "supervisorMayEditScientificValues": false,
    "correctionsReturnToCollector": true,
    "reviewCommentRequiredForCorrection": true,
    "reviewCommentRequiredForRejection": true
  },
  "privacy": {
    "backendSiteNameMayContainPrivateIdentifiers": true,
    "exposeBackendSiteNamePublicly": false,
    "publicSiteLabelPattern": "Sampling Site {siteCode}",
    "hideLandownerFields": true,
    "hideCollectorIdentity": true,
    "hideReviewerIdentity": true,
    "hideInternalAccessNotes": true
  },
  "historicalTimePolicy": {
    "newRecordsRequireTime": true,
    "legacyMissingTimeAllowed": true,
    "technicalPlaceholderLocalTime": "12:00:00",
    "placeholderMustNeverDisplayAsObservedTime": true,
    "flags": {
      "timeKnown": false,
      "timeImputed": true,
      "timePrecision": "DATE_ONLY"
    }
  },
  "acceptanceTest": {
    "preloadHistoricalDatasetDuringDevelopment": false,
    "finalHistoricalUploadPerformedByProjectOwner": true,
    "purpose": "End-to-end ingestion acceptance test"
  },
  "visualObservations": {
    "weather_condition": [
      "Clear",
      "Partly Cloudy",
      "Cloudy",
      "Overcast",
      "Light Rain",
      "Heavy Rain",
      "Snow",
      "Windy",
      "Other",
      "Unknown"
    ],
    "water_color": [
      "Clear",
      "Light Brown",
      "Dark Brown",
      "Greenish",
      "Turbid/Murky",
      "Other",
      "Unknown"
    ],
    "flow_condition": [
      "No Visible Flow",
      "Low",
      "Moderate",
      "High",
      "Unknown"
    ]
  },
  "numericMeasurementPolicy": "All numerical measurements are optional. Missing values remain null/absent; an entered value must satisfy its unit and conversion contract.",
  "laboratoryPolicy": {
    "requestedAnalytes": [
      "CHLORIDE_MG_L",
      "SULFATE_MG_L",
      "NITRATE_MG_L",
      "PHOSPHATE_MG_L"
    ],
    "finalSubmissionRequires": "No pending laboratory work; explicit completion recorded by the collector.",
    "draftStates": [
      "DRAFT",
      "FIELD_COLLECTED",
      "LAB_PENDING",
      "LAB_COMPLETED",
      "READY_FOR_REVIEW"
    ]
  },
  "methodPolicy": {
    "categoryRequired": true,
    "otherTextLabel": "Method / Instrument",
    "instrumentDetailsOptional": true,
    "appliesTo": "each sampling record, never a permanent site preference"
  }
}
