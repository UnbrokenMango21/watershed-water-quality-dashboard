{
  "qualityAlgorithmVersion": "0.1.0",
  "scoreRange": [0, 100],
  "displayRounding": "nearest_integer",
  "principles": {
    "qualityMeasures": "confidence_in_observation_and_provenance",
    "anomalyMeasures": "difference_from_approved_historical_baseline",
    "environmentalAlertsReduceQuality": false,
    "scoreCanAutoApprove": false,
    "blockingErrorsPreventScoring": true
  },
  "weights": {
    "completeness": 0.20,
    "location": 0.20,
    "methodInstrumentTraceability": 0.20,
    "validationConsistency": 0.20,
    "temporalProvenance": 0.10,
    "historicalConsistency": 0.10
  },
  "renormalizeUnavailableComponents": true,
  "historicalConsistency": {
    "minimumBaselineCount": 8,
    "establishedBaselineCount": 20,
    "provisionalWeight": 0.05,
    "fullWeight": 0.10,
    "seasonalWindowDays": 45,
    "baselineMustBeApproved": true,
    "comparisonPriority": [
      "same_site_parameter_method_and_season",
      "same_site_parameter_and_season",
      "same_site_parameter_all_approved_dates"
    ],
    "statistic": "modified_z_score",
    "formula": "0.6745*(x-median)/MAD",
    "ifMadZero": "component_unavailable_unless_defensible_variability_fallback_exists",
    "bands": [
      {"maxAbsZInclusive": 2.0, "score": 100},
      {"maxAbsZInclusive": 3.0, "score": 90},
      {"maxAbsZInclusive": 4.0, "score": 75},
      {"maxAbsZInclusive": null, "score": 60}
    ]
  },
  "location": {
    "formula": "0.65*gpsAccuracyScore + 0.35*siteProximityScore",
    "defaultSiteToleranceM": 30,
    "gpsAccuracyBands": [
      {"maxMetersInclusive": 5, "score": 100},
      {"maxMetersInclusive": 10, "score": 95},
      {"maxMetersInclusive": 20, "score": 85},
      {"maxMetersInclusive": 50, "score": 65},
      {"maxMetersInclusive": null, "score": 40, "warning": true}
    ],
    "missingGps": "ERROR",
    "siteProximityBands": [
      {"maxToleranceMultiplesInclusive": 1, "score": 100},
      {"maxToleranceMultiplesInclusive": 2, "score": 85},
      {"maxToleranceMultiplesInclusive": 4, "score": 60},
      {"maxToleranceMultiplesInclusive": null, "score": 30, "warning": true}
    ]
  },
  "methodInstrumentTraceability": {
    "testTypePoints": 20,
    "methodPoints": 30,
    "instrumentOrLabSourcePoints": 30,
    "calibrationVerificationQcPoints": 20,
    "otherRequiresDescription": true
  },
  "validationConsistency": {
    "formula": "max(50,100-min(40,10*W)-min(10,5*I))",
    "warningPenalty": 10,
    "warningPenaltyCap": 40,
    "infoPenalty": 5,
    "infoPenaltyCap": 10,
    "environmentalAlertsExcluded": true,
    "errors": "BLOCK"
  },
  "temporalProvenance": {
    "exactWithTimezoneAndServerTimestamp": 100,
    "exactTimezoneInferred": 90,
    "historicalDateOnly": 75,
    "imputedTechnicalTime": 75,
    "missingDate": "ERROR",
    "imputedTimeMustNotDisplayAsObserved": true
  },
  "anomalyScore": {
    "enabled": true,
    "publicByDefault": false,
    "parameterFormula": "min(100,25*abs(modified_z_score))",
    "aggregate": "mean_available_parameters",
    "bands": [
      {"maxInclusive": 24, "label": "typical"},
      {"maxInclusive": 49, "label": "mildly_unusual"},
      {"maxInclusive": 74, "label": "unusual"},
      {"maxInclusive": 100, "label": "highly_unusual"}
    ]
  },
  "qualityBands": [
    {"minInclusive": 90, "maxInclusive": 100, "label": "excellent_confidence"},
    {"minInclusive": 80, "maxInclusive": 89, "label": "good_confidence"},
    {"minInclusive": 70, "maxInclusive": 79, "label": "review_attention"},
    {"minInclusive": 60, "maxInclusive": 69, "label": "low_confidence"},
    {"minInclusive": 0, "maxInclusive": 59, "label": "very_low_confidence"}
  ],
  "publicIndicator": {
    "optional": true,
    "value": "latest_approved_observation_quality_score",
    "doNotUseLifetimeAverage": true
  }
}
