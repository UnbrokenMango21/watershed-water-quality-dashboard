{
  "validationRulesVersion": "1.0.0",
  "profileId": "central_pa_freshwater_stream_v1",
  "principle": "Detect questionable data without suppressing legitimate environmental anomalies.",
  "classes": {
    "ERROR": {"blocksReview": true, "reducesQuality": true},
    "PLAUSIBILITY_WARNING": {"blocksReview": false, "reducesQuality": true},
    "ENVIRONMENTAL_ALERT": {"blocksReview": false, "reducesQuality": false},
    "INFO": {"blocksReview": false, "reducesQuality": false}
  },
  "testTypeProfiles": {
    "In-situ/Penn State Lab": {"requiredMeasurements": ["PH", "DO_MG_L", "CONDUCTIVITY_US_CM"], "minimumMeasurementCount": 3},
    "In-situ / Field Instrument": {"requiredMeasurements": ["PH", "DO_MG_L", "CONDUCTIVITY_US_CM"], "minimumMeasurementCount": 3},
    "Continuous Sensor / Sonde": {"requiredMeasurements": ["PH", "DO_MG_L", "CONDUCTIVITY_US_CM"], "minimumMeasurementCount": 3},
    "Mixed In-situ + Lab": {"requiredMeasurements": ["PH", "DO_MG_L", "CONDUCTIVITY_US_CM"], "minimumMeasurementCount": 3},
    "Penn State Lab": {"requiredMeasurements": [], "minimumMeasurementCount": 1},
    "External Lab": {"requiredMeasurements": [], "minimumMeasurementCount": 1},
    "Field Kit / Colorimetric": {"requiredMeasurements": [], "minimumMeasurementCount": 1},
    "Other": {"requiredMeasurements": [], "minimumMeasurementCount": 1}
  },
  "requiredRevisionFields": [
    "site_id", "test_type", "data_collected_by", "method_name", "instrument_name",
    "collected_at", "latitude", "longitude", "gps_accuracy_m",
    "temp_entered_value", "temp_entered_unit", "temp_c", "temp_f"
  ],
  "temperature": {
    "hardRangeC": [-5, 60],
    "contextRangeC": [0, 35],
    "conversionToleranceC": 0.2,
    "conversionToleranceF": 0.36
  },
  "parameters": {
    "PH": {
      "unit": "pH",
      "hardRange": [0, 14],
      "environmentalOutsideRange": [6.0, 9.0],
      "environmentalRuleCode": "ENV_PH_OUTSIDE_PA_AQUATIC_RANGE"
    },
    "DO_MG_L": {
      "unit": "mg/L",
      "hardRange": [0, 50],
      "plausibilityAbove": 25,
      "environmentalBelow": [
        {"value": 5, "ruleCode": "ENV_DO_BELOW_5", "message": "Dissolved oxygen is below 5 mg/L; this may stress aquatic life but is not evidence of bad data."},
        {"value": 3, "ruleCode": "ENV_DO_BELOW_3", "message": "Dissolved oxygen is below 3 mg/L; this is a severe environmental condition but remains scientifically possible."}
      ]
    },
    "DO_PERCENT": {"unit": "%", "hardRange": [0, 300], "plausibilityAbove": 200},
    "CONDUCTIVITY_US_CM": {"unit": "uS/cm", "hardMin": 0},
    "TDS_MG_L": {"unit": "mg/L", "hardMin": 0, "environmentalAbove": 750, "environmentalRuleCode": "ENV_TDS_ABOVE_PA_PWS_MAX", "contextOnly": true},
    "ORP_MV": {"unit": "mV"},
    "CHLORIDE_MG_L": {"unit": "mg/L", "hardMin": 0, "environmentalAbove": 250, "environmentalRuleCode": "ENV_CHLORIDE_ABOVE_PA_PWS_CONTEXT", "contextOnly": true},
    "SULFATE_MG_L": {"unit": "mg/L", "hardMin": 0, "environmentalAbove": 250, "environmentalRuleCode": "ENV_SULFATE_ABOVE_PA_PWS_CONTEXT", "contextOnly": true},
    "NITRATE_MG_L": {"unit": "mg/L", "hardMin": 0, "requiresAnalyteBasis": true, "criterionAsN": 10},
    "PHOSPHATE_MG_L": {"unit": "mg/L", "hardMin": 0, "requiresAnalyteBasis": true},
    "DISCHARGE_M3_S": {"unit": "m3/s", "hardMin": 0}
  },
  "gps": {
    "accuracyBands": [
      {"max": 5, "score": 100}, {"max": 10, "score": 95}, {"max": 20, "score": 85},
      {"max": 50, "score": 65}, {"max": null, "score": 40}
    ],
    "siteProximityBands": [
      {"maxMultiple": 1, "score": 100}, {"maxMultiple": 2, "score": 85},
      {"maxMultiple": 4, "score": 60}, {"maxMultiple": null, "score": 30}
    ],
    "defaultSiteToleranceM": 30
  },
  "temporal": {
    "futureWarningMinutes": 5,
    "futureErrorHours": 24,
    "submittedBeforeCollectedToleranceSeconds": 60
  },
  "crossChecks": {
    "doSaturationRelativeDifferenceWarning": 0.30,
    "tdsConductivityRatioInfoRange": [0.3, 1.0]
  },
  "scientificContext": {
    "paPhAquaticRange": "25 Pa. Code §93.7: pH 6.0-9.0 for CWF/WWF/TSF/MF",
    "paDoMinimum": "25 Pa. Code §93.7: flowing-water minimum generally 5.0 mg/L, with designated-use averaging rules",
    "paContextReferences": "Chloride 250 mg/L, sulfate 250 mg/L, TDS monthly average 500/max 750 mg/L, nitrite+nitrate 10 mg/L as N are designated-use/context references, not generic single-sample data-validity limits",
    "doSaturation": "Temperature-based cross-check uses Weiss (1970) freshwater oxygen solubility at sea level; elevation/barometric pressure can cause legitimate differences"
  }
}
