# =============================================================================
# QC Trusted Web - reviewer interface environment
# =============================================================================
# Copy to `web/.env.local` and fill in real values. `.env.local` is gitignored.
#
# The development target is `central-pa-watershed-dev`. Keep actual local values
# in `.env.local`; do not commit that file.

# -----------------------------------------------------------------------------
# Firebase Web (client) SDK config - used in the browser for sign-in and reads.
# These are public identifiers, not secrets. Firestore Security Rules
# (firebase/firestore.rules) remain the authorization boundary.
# Copy them from Firebase Console > Project settings > Your apps > Web app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-dev-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=central-pa-watershed-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=central-pa-watershed-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=central-pa-watershed-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-dev-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-dev-web-app-id

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server side, used only by
# app/api/submissions/[submissionId]/review/route.ts).
#
# The Admin SDK is initialized with `initializeApp()` and no explicit
# credential, i.e. Application Default Credentials, mirroring
# functions/index.mjs. That means:
#
#   * Production / Cloud Run / App Hosting / GCE: nothing to set here. The
#     runtime service account provides ADC. Grant it Firestore read/write and
#     the `firebaseauth.viewer`-equivalent permission needed to verify tokens.
#
#   * Local development against a real project: point
#     GOOGLE_APPLICATION_CREDENTIALS at a downloaded service-account key, or
#     run `gcloud auth application-default login`. Never commit the key.
#
#   * Local development against the emulators: set the two EMULATOR_HOST vars
#     below. The Admin SDK auto-detects them; no credential is required and no
#     extra code path exists for it.
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=central-pa-watershed-dev

# Emulator-only (leave unset when talking to a real project):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Dev-only test-account provisioning (scripts/provision_test_users.mjs --apply).
# Use a temporary value of at least 6 characters; never commit a real password.
# QC_DEV_TEST_PASSWORD=
