rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : "COLLECTOR";
    }

    function isAdmin() {
      return signedIn() && role() == "ADMIN";
    }

    function isReviewer() {
      return signedIn() && role() == "QC_REVIEWER";
    }

    function submissionPath(submissionId) {
      return /databases/$(database)/documents/submissions/$(submissionId);
    }

    function revisionPath(submissionId, revisionId) {
      return /databases/$(database)/documents/submissions/$(submissionId)/revisions/$(revisionId);
    }

    function sitePath(siteId) {
      return /databases/$(database)/documents/siteCatalog/$(siteId);
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function validTestType(value) {
      return value in [
        "In-situ / Field Instrument",
        "Penn State Lab",
        "External Lab",
        "Field Kit / Colorimetric",
        "Continuous Sensor / Sonde",
        "Mixed In-situ + Lab",
        "Other"
      ];
    }

    function ownsSubmission(submissionId) {
      return signedIn()
        && get(submissionPath(submissionId)).data.collector_user_id == uid();
    }

    function canReadSubmission(submissionId) {
      return ownsSubmission(submissionId) || isAdmin() || isReviewer();
    }

    function collectorSubmissionUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "current_revision_id",
        "current_revision_no",
        "latest_collected_at",
        "updated_at",
        "submitted_at",
        "mobile_app_version"
      ]);
    }

    function validCollectorSubmissionTransition() {
      return (
        resource.data.status == "DRAFT"
        && request.resource.data.status in ["DRAFT", "SUBMITTED"]
      ) || (
        resource.data.status == "NEEDS_CORRECTION"
        && request.resource.data.status in ["NEEDS_CORRECTION", "RESUBMITTED"]
      );
    }

    function validFinalRevisionLink(submissionId) {
      let revision = get(revisionPath(submissionId, request.resource.data.current_revision_id));
      return revision.data.submission_id == submissionId
        && revision.data.event_id == request.resource.data.event_id
        && revision.data.collector_user_id == uid()
        && revision.data.revision_no == request.resource.data.current_revision_no
        && revision.data.revision_status == "SUBMITTED";
    }

    function revisionIsDraft(submissionId, revisionId) {
      return get(revisionPath(submissionId, revisionId)).data.revision_status == "DRAFT";
    }

    function collectorRevisionAllowedKeys() {
      return [
        "revision_id",
        "revision_no",
        "submission_id",
        "event_id",
        "collector_user_id",
        "site_id",
        "revision_status",
        "created_at",
        "submitted_at",
        "collected_at",
        "time_known",
        "time_imputed",
        "latitude",
        "longitude",
        "location",
        "gps_accuracy_m",
        "site_distance_m",
        "weather_condition",
        "data_collected_by",
        "test_type",
        "test_type_other",
        "method_name",
        "instrument_name",
        "instrument_other",
        "temp_entered_value",
        "temp_entered_unit",
        "temp_c",
        "temp_f",
        "field_notes_original",
        "schema_version",
        "mobile_app_version"
      ];
    }

    function collectorRevisionRequiredKeys() {
      return [
        "revision_id",
        "revision_no",
        "submission_id",
        "event_id",
        "collector_user_id",
        "site_id",
        "revision_status",
        "created_at",
        "collected_at",
        "latitude",
        "longitude",
        "gps_accuracy_m",
        "data_collected_by",
        "test_type",
        "method_name",
        "instrument_name",
        "temp_entered_value",
        "temp_entered_unit",
        "temp_c",
        "temp_f",
        "schema_version",
        "mobile_app_version"
      ];
    }

    function validCollectorRevisionCreate(submissionId, revisionId) {
      return request.resource.data.keys().hasOnly(collectorRevisionAllowedKeys())
        && request.resource.data.keys().hasAll(collectorRevisionRequiredKeys())
        && request.resource.data.revision_id == revisionId
        && request.resource.data.submission_id == submissionId
        && request.resource.data.collector_user_id == uid()
        && request.resource.data.event_id == get(submissionPath(submissionId)).data.event_id
        && request.resource.data.site_id == get(submissionPath(submissionId)).data.site_id
        && request.resource.data.revision_status == "DRAFT"
        && request.resource.data.revision_no is int
        && request.resource.data.revision_no >= 1
        && request.resource.data.created_at is timestamp
        && request.resource.data.collected_at is timestamp
        && request.resource.data.submitted_at == null
        && request.resource.data.time_known is bool
        && request.resource.data.time_imputed is bool
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && !(request.resource.data.latitude == 0 && request.resource.data.longitude == 0)
        && request.resource.data.gps_accuracy_m is number
        && request.resource.data.gps_accuracy_m >= 0
        && nonEmptyString(request.resource.data.data_collected_by)
        && validTestType(request.resource.data.test_type)
        && (request.resource.data.test_type != "Other" || nonEmptyString(request.resource.data.test_type_other))
        && nonEmptyString(request.resource.data.method_name)
        && nonEmptyString(request.resource.data.instrument_name)
        && request.resource.data.temp_entered_value is number
        && request.resource.data.temp_c is number
        && request.resource.data.temp_f is number
        && request.resource.data.temp_entered_unit in ["C", "F"]
        && request.resource.data.schema_version == "0.1.0"
        && nonEmptyString(request.resource.data.mobile_app_version)
        && (
          (get(submissionPath(submissionId)).data.status == "DRAFT" && request.resource.data.revision_no == 1)
          || (get(submissionPath(submissionId)).data.status == "NEEDS_CORRECTION"
            && request.resource.data.revision_no == get(submissionPath(submissionId)).data.current_revision_no + 1)
        );
    }

    function validCollectorRevisionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(collectorRevisionAllowedKeys())
        && request.resource.data.keys().hasOnly(collectorRevisionAllowedKeys())
        && request.resource.data.keys().hasAll(collectorRevisionRequiredKeys())
        && request.resource.data.revision_id == resource.data.revision_id
        && request.resource.data.revision_no == resource.data.revision_no
        && request.resource.data.submission_id == resource.data.submission_id
        && request.resource.data.event_id == resource.data.event_id
        && request.resource.data.collector_user_id == resource.data.collector_user_id
        && request.resource.data.site_id == resource.data.site_id
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.revision_status in ["DRAFT", "SUBMITTED"]
        && request.resource.data.submitted_at == request.time
        && request.resource.data.temp_entered_unit in ["C", "F"]
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.gps_accuracy_m is number
        && request.resource.data.temp_entered_value is number
        && request.resource.data.temp_c is number
        && request.resource.data.temp_f is number;
    }

    function measurementAllowedKeys() {
      return [
        "measurement_id",
        "parameter_code",
        "display_name",
        "value",
        "unit_code",
        "entered_value",
        "entered_unit_code",
        "method_name",
        "instrument_name",
        "qualifier",
        "notes",
        "entered_at"
      ];
    }

    function validParameterUnit(parameterCode, unitCode) {
      return (parameterCode == "PH" && unitCode == "pH")
        || (parameterCode == "DO_MG_L" && unitCode == "mg/L")
        || (parameterCode == "DO_PERCENT" && unitCode == "percent")
        || (parameterCode == "CONDUCTIVITY_US_CM" && unitCode == "uS/cm")
        || (parameterCode == "TDS_MG_L" && unitCode == "mg/L")
        || (parameterCode == "ORP_MV" && unitCode == "mV")
        || (parameterCode in ["CHLORIDE_MG_L", "SULFATE_MG_L"] && unitCode == "mg/L")
        || (parameterCode == "NITRATE_MG_L" && unitCode == "mg/L as N")
        || (parameterCode == "PHOSPHATE_MG_L" && unitCode == "mg/L as P")
        || (parameterCode == "DISCHARGE_M3_S" && unitCode == "m3/s");
    }

    function validMeasurement(measurementId) {
      return request.resource.data.keys().hasOnly(measurementAllowedKeys())
        && request.resource.data.keys().hasAll([
          "measurement_id",
          "parameter_code",
          "display_name",
          "value",
          "unit_code",
          "entered_value",
          "entered_unit_code",
          "method_name",
          "instrument_name",
          "entered_at"
        ])
        && request.resource.data.measurement_id == measurementId
        && nonEmptyString(request.resource.data.display_name)
        && request.resource.data.value is number
        && validParameterUnit(request.resource.data.parameter_code, request.resource.data.unit_code)
        && request.resource.data.entered_value is number
        && nonEmptyString(request.resource.data.entered_unit_code)
        && nonEmptyString(request.resource.data.method_name)
        && nonEmptyString(request.resource.data.instrument_name)
        && request.resource.data.entered_at is timestamp;
    }

    function attachmentAllowedKeys() {
      return [
        "attachment_id",
        "storage_path",
        "content_type",
        "size_bytes",
        "kind",
        "caption",
        "created_at"
      ];
    }

    function validAttachmentPath(submissionId, revisionId, attachmentId) {
      let base = "users/" + uid() + "/submissions/" + submissionId + "/revisions/" + revisionId + "/" + attachmentId;
      return (request.resource.data.content_type == "image/jpeg" && request.resource.data.storage_path == base + ".jpg")
        || (request.resource.data.content_type == "image/png" && request.resource.data.storage_path == base + ".png")
        || (request.resource.data.content_type == "image/heic" && request.resource.data.storage_path == base + ".heic")
        || (request.resource.data.content_type in ["audio/mp4", "audio/m4a"] && request.resource.data.storage_path == base + ".m4a")
        || (request.resource.data.content_type == "application/pdf" && request.resource.data.storage_path == base + ".pdf");
    }

    function validAttachment(submissionId, revisionId, attachmentId) {
      return request.resource.data.keys().hasOnly(attachmentAllowedKeys())
        && request.resource.data.keys().hasAll([
          "attachment_id",
          "storage_path",
          "content_type",
          "size_bytes",
          "kind",
          "created_at"
        ])
        && request.resource.data.attachment_id == attachmentId
        && request.resource.data.size_bytes is int
        && request.resource.data.size_bytes > 0
        && request.resource.data.size_bytes <= 50 * 1024 * 1024
        && request.resource.data.created_at is timestamp
        && validAttachmentPath(submissionId, revisionId, attachmentId)
        && request.resource.data.kind in ["SITE_PHOTO", "INSTRUMENT_PHOTO", "TEST_RESULT", "OTHER"];
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow write: if false;
    }

    match /siteCatalog/{siteId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.collector_user_id == uid()
        && request.resource.data.submission_id == submissionId
        && request.resource.data.status == "DRAFT"
        && nonEmptyString(request.resource.data.event_id)
        && nonEmptyString(request.resource.data.site_id)
        && exists(sitePath(request.resource.data.site_id))
        && get(sitePath(request.resource.data.site_id)).data.active == true
        && request.resource.data.current_revision_no == 1
        && nonEmptyString(request.resource.data.current_revision_id)
        && request.resource.data.latest_collected_at is timestamp
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp
        && request.resource.data.submitted_at == null
        && request.resource.data.schema_version == "0.1.0"
        && nonEmptyString(request.resource.data.mobile_app_version)
        && request.resource.data.keys().hasOnly([
          "submission_id",
          "event_id",
          "collector_user_id",
          "site_id",
          "status",
          "current_revision_id",
          "current_revision_no",
          "latest_collected_at",
          "created_at",
          "updated_at",
          "submitted_at",
          "schema_version",
          "mobile_app_version"
        ]);

      allow read: if signedIn()
        && (!exists(submissionPath(submissionId))
          || resource.data.collector_user_id == uid()
          || isAdmin()
          || isReviewer());

      allow update: if signedIn()
        && resource.data.collector_user_id == uid()
        && request.resource.data.collector_user_id == resource.data.collector_user_id
        && request.resource.data.submission_id == resource.data.submission_id
        && request.resource.data.event_id == resource.data.event_id
        && collectorSubmissionUpdateKeysOnly()
        && validCollectorSubmissionTransition()
        && request.resource.data.site_id == resource.data.site_id
        && request.resource.data.current_revision_no is int
        && request.resource.data.latest_collected_at is timestamp
        && request.resource.data.updated_at is timestamp
        && request.resource.data.submitted_at == request.time
        && (
          request.resource.data.status in ["DRAFT", "NEEDS_CORRECTION"]
          || validFinalRevisionLink(submissionId)
        );

      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if canReadSubmission(submissionId);

        allow create: if ownsSubmission(submissionId)
          && get(submissionPath(submissionId)).data.status in ["DRAFT", "NEEDS_CORRECTION"]
          && validCollectorRevisionCreate(submissionId, revisionId);

        allow update: if ownsSubmission(submissionId)
          && resource.data.collector_user_id == uid()
          && resource.data.revision_status == "DRAFT"
          && validCollectorRevisionUpdate();

        allow delete: if ownsSubmission(submissionId)
          && resource.data.revision_status == "DRAFT";

        match /measurements/{measurementId} {
          allow read: if canReadSubmission(submissionId);

          allow create, update: if ownsSubmission(submissionId)
            && revisionIsDraft(submissionId, revisionId)
            && validMeasurement(measurementId);

          allow delete: if ownsSubmission(submissionId)
            && revisionIsDraft(submissionId, revisionId);
        }

        match /attachments/{attachmentId} {
          allow read: if canReadSubmission(submissionId);

          allow create, update: if ownsSubmission(submissionId)
            && revisionIsDraft(submissionId, revisionId)
            && validAttachment(submissionId, revisionId, attachmentId);

          allow delete: if ownsSubmission(submissionId)
            && revisionIsDraft(submissionId, revisionId);
        }

        match /validationFlags/{flagId} {
          allow read: if canReadSubmission(submissionId);
          allow write: if false;
        }
      }

      match /audit/{auditId} {
        allow read: if canReadSubmission(submissionId);
        allow write: if false;
      }
    }

    // Default deny. Server Admin SDK / IAM performs trusted validation,
    // review synchronization, audit, scoring and publication writes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
